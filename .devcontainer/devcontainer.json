{
  "name": "Kotlin Development Environment",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspace",
  "shutdownAction": "stopCompose",
  "forwardPorts": [8222, 8989, 8080, 8888, 8090, 8091, 8092, 8093, 8094, 8095, 8096],
  "customizations": {
    "vscode": {
      "extensions": [
        "fwcd.kotlin",
        "vscjava.vscode-java-pack",
        "vscjava.vscode-maven",
        "ms-vscode.vscode-json",
        "redhat.vscode-yaml",
        "ms-azuretools.vscode-docker"
      ],
      "settings": {
        "java.home": "/usr/lib/jvm/java-21-openjdk-amd64",
        "java.configuration.runtimes": [
          {
            "name": "JavaSE-21",
            "path": "/usr/lib/jvm/java-21-openjdk-amd64"
          }
        ],
        "maven.executable.path": "/usr/bin/mvn"
      }
    }
  },
  "postCreateCommand": "echo 'Development environment ready!' && java -version && kotlinc -version && mvn -version"
}