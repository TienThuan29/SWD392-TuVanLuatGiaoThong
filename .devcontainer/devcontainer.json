{
	"name": "springnextjs-template",
	"dockerComposeFile": "docker-compose.yml",
	"service": "dev",
	"workspaceFolder": "/workspace",
	"portsAttributes": {
		"10240": {
			"label": "SpringNextjs-Template"
		},
		"15672": {
			"label": "RabbitMQ UI"
		}
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"dbaeumer.vscode-eslint",
				"EditorConfig.EditorConfig",
				"esbenp.prettier-vscode"
			]
		}
	},
	"features": {
		"ghcr.io/devcontainers/features/java:1": {},
		"ghcr.io/mikaello/devcontainer-features/kotlinc:1": {},
		"ghcr.io/devcontainers-extra/features/kotlin-sdkman:2": {},
		"ghcr.io/devcontainers-extra/features/maven-sdkman:2": {}
	}
}